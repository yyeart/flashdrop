POSTGRES_USER=flashdrop
POSTGRES_PASSWORD=flashdrop
POSTGRES_DB=flashdrop
DATABASE_URL=postgres://flashdrop:flashdrop@127.0.0.1:5432/flashdrop?sslmode=disable

LOG_LEVEL=DEBUG
SHUTDOWN_TIMEOUT=10s

HTTP_ADDR=127.0.0.1:8080
HTTP_REQUEST_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=5s

RESERVATION_TTL=15m

JWT_TTL=15m
JWT_ISSUER=
JWT_AUDIENCE=

JWT_PRIVATE_KEY_FILE=.dev/keys/private.pem
JWT_PUBLIC_KEY_FILE=.dev/keys/public.pem